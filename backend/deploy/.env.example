AUTOBOOK_TRAINING_SCHEDULE_HOUR=3
AUTOBOOK_TRAINING_MIN_NEW_SAMPLES=1000
AUTOBOOK_TRAINING_MIN_TOTAL_SAMPLES=100
AUTOBOOK_TRAINING_MIN_PER_CLASS=10
