<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        前台服务权限声明。
        说明：
        1. 截图记账常驻入口依赖前台服务常驻运行。
        2. Android 14+ 需要额外声明与 `foregroundServiceType` 对应的细分权限，
           当前截图记账服务声明的是 `dataSync`，因此这里同时保留 `FOREGROUND_SERVICE_DATA_SYNC`。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.autobook.cn.app.AutobookApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autobook">

        <!--
            应用主入口 Activity。
            说明：
            1. 该组件需要暴露给系统桌面，因此保持 `exported=true`。
            2. 这里显式使用完整类名，避免包名调整时入口解析产生偏差。
        -->
        <activity
            android:name="com.autobook.cn.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Autobook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            截图通知动作的透明跳板 Activity。
            说明：
            1. 该组件只承接应用自己创建的通知点击，不应该被外部应用直接拉起。
            2. 因此这里显式设置 `exported=false`，把截图链路收口为应用内入口。
            3. 组件本身不展示 UI，只负责快速转发动作并立即结束。
        -->
        <activity
            android:name="com.autobook.cn.app.capture.PageCaptureActionActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            截图记账前台服务。
            说明：
            1. 服务只允许应用内显式 Intent 启动，因此保持 `exported=false`。
            2. 常驻通知和截图分析链路都由该服务统一负责。
        -->
        <service
            android:name="com.autobook.cn.app.capture.PageCaptureBookkeepingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
