<?xml version="1.0" encoding="utf-8"?>
<!--
    折叠态截图快捷记账通知布局。

    用途说明：
    - 把“立即截图记账 / 关闭入口”按钮直接放进通知内容区，避免部分 ROM 不展示标准 action 时入口完全消失。
    - 根布局本身也可点击，保持“点整条通知即可截图”的行为一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_capture_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/page_capture_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@android:color/primary_text_light"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/page_capture_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textColor="@android:color/secondary_text_light"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/page_capture_capture_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="立即截图记账"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/page_capture_stop_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="36dp"
            android:text="关闭入口"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
