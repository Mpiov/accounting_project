<?xml version="1.0" encoding="utf-8"?>
<!--
    展开态截图快捷记账通知布局。

    用途说明：
    - 与折叠态保持相同入口，但给状态文本更大的展示空间。
    - 这样在“正在截图”“截图失败”“待确认已生成”等状态下，用户能更直观看到处理结果。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_capture_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/page_capture_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@android:color/primary_text_light"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/page_capture_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="4"
        android:textColor="@android:color/secondary_text_light"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/page_capture_capture_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:text="立即截图记账"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/page_capture_stop_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="38dp"
            android:text="关闭入口"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
